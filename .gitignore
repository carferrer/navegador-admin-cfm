# Only the project sources, tests and generic documentation belong in Git.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/SECURITY.md
!/NOTICE.md
!/repository.yaml
!/package.json
!/package-lock.json
!/admin_browser/
!/tests/

# Local dependencies, evidence, runtime state and credentials are always private.
node_modules/
test-results/
security/
work/
outputs/
.cfm-security-review/
.env
.env.*
*.log
*.zip
*.tar
*.pem
*.key
*.p12
*.pfx
options.json
options.test.json
credentials.json
secrets.yaml
cookies.sqlite*
places.sqlite*
logins.json
key4.db
cert9.db
profile/
profile-esr/
exchange/
backups/
.DS_Store
Thumbs.db
